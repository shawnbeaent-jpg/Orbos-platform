// ORBOS Platform — database schema
// Mirrors the tabs of the ORBOS_CRM_Tracker.xlsx: Companies, Contacts, Sales Pipeline,
// Marketing Assets, Routes. Run npx prisma migrate dev --name init after setting DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  A
  B
  C
}

enum Status {
  NEW_LEAD
  CONTACTED
  QUALIFIED
  APPOINTMENT_SET
  PROPOSAL_SENT
  CLOSED_WON
  CLOSED_LOST
}

enum PipelineStage {
  LEAD
  CONTACTED
  QUALIFIED
  MEETING
  PROPOSAL
  CLOSED_WON
  CLOSED_LOST
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("owner") // "owner" | "viewer" — expand only when you have a real team
  createdAt DateTime @default(now())
}

model Company {
  id                String          @id @default(cuid())
  name              String
  industry          String
  address           String
  city              String
  phone             String?
  website           String?
  contactPerson     String?         // role placeholder until a named contact is confirmed
  priority          Priority
  status            Status          @default(NEW_LEAD)
  estDealValueCents Int?            // stored in cents, format as dollars in the UI
  latitude          Float?
  longitude         Float?
  notes             String?
  dateAdded         DateTime        @default(now())
  lastContactDate   DateTime?
  contacts          Contact[]
  pipelineEntries   PipelineEntry[]
  routeStops        RouteStop[]

  @@index([priority])
  @@index([status])
}

model Contact {
  id                      String    @id @default(cuid())
  companyId               String
  company                 Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                    String
  title                   String?
  email                   String?
  phone                   String?
  preferredContactMethod  String?
  lastContactDate         DateTime?
  notes                   String?
}

model PipelineEntry {
  id                  String        @id @default(cuid())
  companyId           String
  company             Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stage               PipelineStage @default(LEAD)
  estimatedValueCents Int?
  probability         Float?        // stored as a fraction, e.g. 0.5 = 50%
  expectedCloseDate   DateTime?
  owner               String?
  notes               String?
  updatedAt           DateTime      @updatedAt
}

model MarketingAsset {
  id          String   @id @default(cuid())
  assetName   String
  campaign    String?
  industry    String?
  assetLink   String?
  status      String   @default("Draft") // Draft | In Review | Approved | Published | Archived
  dateCreated DateTime @default(now())
}

model Route {
  id    String      @id @default(cuid())
  name  String
  date  DateTime
  stops RouteStop[]
}

model RouteStop {
  id              String  @id @default(cuid())
  routeId         String
  route           Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company @relation(fields: [companyId], references: [id])
  stopOrder       Int
  purpose         String?
  estDistanceMi   Float?
  estDriveTimeMin Int?
  notes           String?
}

// AI agent output is logged, never silently applied — a human confirms before it
// affects Company/PipelineEntry data. See CLAUDE.md "Do not" section.
model AgentSuggestion {
  id        String   @id @default(cuid())
  agentType String   // "lead_scoring" | "email_draft" | ...
  companyId String?
  input     String   // JSON-serialized input context
  output    String   // JSON-serialized suggested output
  accepted  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============================================================================
// GA Land Clearing — public website lead capture (branch: ga-land-clearing).
// Leads arrive from the multi-step Request-a-Quote flow and the commercial /
// builder / realtor forms. Scored 0–100 at intake; category + score are
// suggestions the internal team can override (no unconfirmed changes rule).
// ============================================================================

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  SITE_VISIT
  PROPOSAL
  WON
  SCHEDULED
  COMPLETED
  LOST
  NURTURE
}

enum LeadCategory {
  PRIORITY
  QUALIFIED
  NEEDS_REVIEW
  LOW_QUALITY
}

model Lead {
  id             String       @id @default(cuid())
  publicId       String       @unique // human-friendly lead ID, e.g. GLC-8F3K2A
  // Contact
  name           String
  email          String
  phone          String
  smsConsent     Boolean      @default(false)
  // Property
  address        String?
  city           String?
  county         String?
  propertyType   String?      // residential | commercial | agricultural | municipal
  acreage        String?      // banded value (under-1, 1-3, ...)
  access         String?
  // Project
  services       String       @default("[]") // JSON array of service slugs
  siteConditions String?
  timeline       String?
  budget         String?
  ownership      String?
  // Files
  uploadKeys     String       @default("[]") // JSON array of stored file references
  // Attribution
  source         String?      // form origin: quote | commercial | builder | realtor
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  referrer       String?
  // Scoring (suggestions — override via scoreOverride)
  score          Int          @default(0)
  scoreOverride  Int?
  category       LeadCategory @default(NEEDS_REVIEW)
  scoreFactors   String       @default("[]") // JSON breakdown for the admin view
  // Pipeline
  stage          LeadStage    @default(NEW)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  notes          LeadNote[]
  tasks          LeadTask[]

  @@index([stage])
  @@index([category])
  @@index([createdAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author    String   @default("system")
  body      String
  createdAt DateTime @default(now())
}

model LeadTask {
  id        String    @id @default(cuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title     String
  dueAt     DateTime?
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())
}

// Immutable audit trail for admin actions (stage changes, score overrides).
model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entity    String
  entityId  String
  detail    String   @default("{}") // JSON
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
