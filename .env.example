# GA Land Clearing — environment variables.
# Copy to .env.local and fill in real values. Never commit real secrets.
# Every secret below is server-side only; nothing here is exposed to the client
# except values explicitly prefixed with NEXT_PUBLIC_.

# ---- Database (required for lead persistence + admin) ----
# PostgreSQL / Supabase connection string. Without it the site still renders and
# accepts leads, but leads are not persisted and the admin dashboard is empty.
DATABASE_URL="postgresql://user:password@host:5432/galandclearing?schema=public"

# ---- Auth (required before exposing /admin) ----
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Admin dashboard login. When BOTH are set, /admin requires sign-in.
# When unset, /admin stays open (local dev only) with a warning banner.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# ---- Email notifications (optional) ----
# Resend API key. When unset, confirmation/internal emails are skipped (no crash).
RESEND_API_KEY=""
# Internal inbox that receives new-lead alerts. Defaults to site.email.
LEAD_INBOX=""

# ---- SMS notifications (optional, consent-gated) ----
# Twilio. SMS is sent only when the lead opted in AND all three are set.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# ---- Secure file uploads (optional) ----
# Supabase Storage. When set, quote-form files upload directly to a private bucket
# via signed URLs. When unset, the form records file names only (no crash).
# SUPABASE_URL is the project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_UPLOAD_BUCKET="lead-uploads"

# ---- Maps / Places (optional) ----
# Google Maps + Places for address autocomplete. Keep server key server-side;
# only expose a properly-restricted browser key via NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""

# ---- Analytics (optional) ----
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# ---- Bot protection (optional) ----
# Cloudflare Turnstile. A server-side honeypot is always active regardless.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---- Monitoring (optional) ----
SENTRY_DSN=""

# ---- AI assistant (optional, Phase later) ----
ANTHROPIC_API_KEY=""
