# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string — from Neon, Supabase, or any Postgres host
DATABASE_URL="postgresql://user:password@host:5432/orbos?schema=public"

# Auth.js — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Anthropic API key for the AI agent layer (Phase 5+) — from platform.claude.com
ANTHROPIC_API_KEY=""

# Email provider for outreach sending (Phase 6) — e.g. Resend
RESEND_API_KEY=""
