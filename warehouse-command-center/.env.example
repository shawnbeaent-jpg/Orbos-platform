# Warehouse Command Center — environment variables
# Copy to .env.local for local development. NEVER commit real values.

# ---- Supabase (public, safe for the browser) ----
# Project URL and anon key are exposed to the client by design. RLS protects data.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ---- Supabase (server-only, NEVER expose to the browser) ----
# The service role bypasses RLS. Used only in trusted server code (seeding, admin ops).
# Do not prefix with NEXT_PUBLIC_. Do not import into client components.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---- Application ----
# Canonical site URL, used for auth redirects and absolute links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Comma-separated list of allowed upload MIME types (documents/photos).
# Defaults are applied in lib/env.ts when unset.
# UPLOAD_ALLOWED_MIME="image/jpeg,image/png,image/webp,application/pdf"

# Max upload size in bytes (default 15MB).
# UPLOAD_MAX_BYTES="15728640"
